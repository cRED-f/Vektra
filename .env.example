# Vektra backend configuration — copy to .env and fill in values.

# Vektra backend configuration — copy to .env and fill in values.

# Database (PostgreSQL + pgvector)
VEKTRA_DATABASE_URL=postgresql+asyncpg://vektra:vektra@localhost:5432/vektra
VEKTRA_DATABASE_echo=false
# Create tables on startup (dev convenience). Use Alembic/migrations in prod.
VEKTRA_AUTO_CREATE_TABLES=true

# Ollama
VEKTRA_OLLAMA_HOST=http://localhost:11434
VEKTRA_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
VEKTRA_OLLAMA_GENERATION_MODEL=qwen2.5:1.5b

# Serving
VEKTRA_SERVING_BACKEND=ollama
VEKTRA_BATCH_MAX_SIZE=8
VEKTRA_BATCH_MAX_WAIT_MS=50

# Retrieval
VEKTRA_RETRIEVAL_TOP_K=20
VEKTRA_RERANK_TOP_K=5
VEKTRA_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Auth
VEKTRA_API_TOKEN=dev-token-change-in-production

# Gateway
VEKTRA_GATEWAY_HOST=0.0.0.0
VEKTRA_GATEWAY_PORT=8000
VEKTRA_RATE_LIMIT_PER_MINUTE=60

# Observability
VEKTRA_LOG_LEVEL=INFO
VEKTRA_PROMETHEUS_ENABLED=true

# Frontend (list fields are parsed as JSON)
VEKTRA_FRONTEND_URL=http://localhost:3000
VEKTRA_CORS_ORIGINS=["http://localhost:3000"]

# Debug
VEKTRA_DEBUG=false
